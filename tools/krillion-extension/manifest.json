{
  "manifest_version": 3,
  "name": "Krillion Deck",
  "version": "1.0.0",
  "description": "Shows the day's best answer beside each Krillion prompt, and stops a near-miss spelling from scoring zero.",
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://krillion.io/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.aedinlai.com/*", "https://aedinlai.com/*"]
}
